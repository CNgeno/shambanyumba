@model IReadOnlyList<PhotoRow>
@{
    var stay = (StayListItem)ViewData["Stay"]!;
    var canEdit = ViewData["CanEdit"] is true;
    ViewData["Title"] = $"Photos: {stay.Title}";
}
<section class="bk-wrap">
    <p class="bk-back"><a href="/host/stays/@stay.StayUnitId/view">&larr; @stay.Title</a></p>
    <div class="bk-panel">
        <h1 class="bk-title">Photos: @stay.Title</h1>
        <p class="bk-muted">The rooms guests will use: bedroom, living area, kitchen, bathroom. The first photo shows on the guest site's search results.</p>
        <div class="bk-thumbs">
            @foreach (var ph in Model)
            {
                <figure>
                    <img src="/host/photo/unit/@ph.Id" alt="@ph.FileName" loading="lazy" />
                    @if (canEdit) { <form method="post" action="/host/units/@stay.UnitId/photos/@ph.Id/remove">@Html.AntiForgeryToken()<button type="submit" class="bk-link">Remove</button></form> }
                </figure>
            }
            @if (Model.Count == 0) { <p class="bk-muted">No photos yet.</p> }
        </div>
        @if (canEdit)
        {
            <form method="post" action="/host/units/@stay.UnitId/photos" enctype="multipart/form-data" class="bk-form">
                @Html.AntiForgeryToken()
                <input type="file" name="files" accept="image/*" multiple required />
                <button type="submit" class="bk-btn bk-btn-small bk-btn-primary">Upload photos</button>
            </form>
        }
    </div>
</section>
