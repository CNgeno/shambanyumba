@model IReadOnlyList<StayListItem>
@{
    ViewData["Title"] = "Short stays";

    string Kes(decimal v) => "KES " + v.ToString("N0");
}
<section class="bk-wrap bk-panel">
    <div class="bk-head" style="margin-top:0">
        <div><p class="bk-eyebrow">Host</p><h1 class="bk-title">Your short stays</h1></div>
        <div class="bk-actions bk-actions-tight">
            <a class="bk-btn bk-btn-light bk-btn-outline" href="/host/properties">Your properties</a>
            <a class="bk-btn bk-btn-primary" href="/host/properties/new">Add property</a>
            <form method="post" action="/host/stays/publish-all" class="bk-inline">@Html.AntiForgeryToken()<button type="submit" class="bk-btn bk-btn-light bk-btn-outline">Publish all ready</button></form>
        </div>
    </div>
    <p class="bk-muted">Every unit of your properties is a stay. <strong>Draft</strong> stays can't be booked by anyone yet; <strong>Published</strong> ones appear on the guest site and the calendar. Add rooms or flats under <a href="/host/properties">Your properties</a>.</p>
    <div class="bk-table-wrap">
        <table class="bk-table">
            <thead><tr><th>Unit</th><th>Property</th><th>Stay</th><th class="bk-right">Nightly</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><strong>@u.UnitNumber</strong>@(u.Bedrooms is int b ? $" · {b} bed" : "")</td>
                    <td>@u.PropertyName</td>
                    <td><span class="bk-badge @(u.IsPublished ? "bk-badge-on" : "")">@(u.IsPublished ? "Published" : "Draft")</span> @u.Title</td>
                    <td class="bk-right">@(u.BaseNightly is decimal n && n > 0 ? Kes(n) : "")</td>
                    <td class="bk-right">
                        <a class="bk-btn bk-btn-small bk-btn-primary" href="/host/stays/@u.StayUnitId/view">View</a>
                        <form method="post" action="/host/stays/@u.StayUnitId/publish" class="bk-inline">@Html.AntiForgeryToken()<input type="hidden" name="published" value="@(!u.IsPublished)" /><button type="submit" class="bk-btn bk-btn-small bk-btn-light bk-btn-outline">@(u.IsPublished ? "Unpublish" : "Publish")</button></form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="bk-muted">No stays yet. <a href="/host/start">Get started</a>: add your property and its rooms or flats.</td></tr> }
            </tbody>
        </table>
    </div>
</section>
