@model AdminBusinessesViewModel
@{
    ViewData["Title"] = "Businesses";
}
<div class="page-head">
    <div class="me-auto">
        <h1 class="page-title">Businesses</h1>
        <p class="page-sub">@Model.Businesses.Count shown</p>
    </div>
    <form method="get" class="d-flex gap-2" role="search">
        <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Business name" aria-label="Search businesses" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
    </form>
</div>

<section class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>#</th><th>Business</th><th>Owner</th><th>Plan</th><th>Status</th><th>Paid through</th><th class="text-end">Members</th><th class="text-end">Credits</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Businesses)
            {
                var b = row.Business;
                var s = row.Subscription;
                <tr>
                    <td class="text-body-secondary">@b.Id</td>
                    <td class="fw-semibold">@b.Name<div class="small text-body-secondary fw-normal">@b.Type, since @b.CreatedAtUtc.ToEatDate()</div></td>
                    <td class="small">@(b.OwnerEmail ?? "—")</td>
                    <td>@s.PlanName</td>
                    <td><partial name="_SubscriptionStatusBadge" model="s.Status" /></td>
                    <td class="small text-nowrap">@s.PaidThroughUtc.ToEatDate()</td>
                    <td class="text-end">@b.MemberCount</td>
                    <td class="text-end">@b.CreditBalance</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
<p class="small text-body-secondary mt-2">To adjust credits, use the business # on the <a asp-controller="AdminCredits" asp-action="Index">Credit purchases</a> page.</p>
