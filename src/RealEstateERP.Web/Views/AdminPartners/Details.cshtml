@model PartnerDetails
@{
    var p = Model.Partner;
    ViewData["Title"] = p.Name;
    var link = $"https://shambanyumba.com/?ref={p.Code}";
}
<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Partners</a>
<div class="page-head"><div class="me-auto"><h1 class="page-title">@p.Name</h1>
    <p class="page-sub">@p.Kind.Display()@(p.ReferrerBusinessName is null ? "" : $" · customer: {p.ReferrerBusinessName}")</p></div></div>

<section class="stat-strip mb-3">
    <div class="stat"><span class="stat-label">Code</span><span class="stat-value"><code>@p.Code</code></span></div>
    <div class="stat"><span class="stat-label">Trials started</span><span class="stat-value">@p.Trials</span></div>
    <div class="stat"><span class="stat-label">Paying customers</span><span class="stat-value">@p.Paying</span></div>
    <div class="stat"><span class="stat-label">Commission owed</span><span class="stat-value @(p.Owed > 0 ? "text-danger" : "")">KES @p.Owed.ToString("N0")</span><span class="stat-note">KES @p.Paid.ToString("N0") paid</span></div>
</section>

<section class="panel mb-3">
    <h2 class="panel-title mb-2">Their link</h2>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <code id="partner-link">@link</code>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('partner-link').textContent); this.textContent='Copied';">Copy</button>
    </div>
    <p class="form-text mb-0">Visitors who arrive through this link are remembered for 60 days. People can also type the code when creating their business.</p>
</section>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="panel p-0">
            <div class="units-toolbar"><h2 class="panel-title">Businesses they brought</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-stack">
                    <thead><tr><th>Business</th><th>Started</th><th>Status</th><th class="text-end">Commission</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Businesses)
                    {
                        <tr>
                            <td class="fw-semibold">@b.Name</td>
                            <td>@b.CreatedAtUtc.ToEatDate()</td>
                            <td>@(b.Paying ? "Paying" : "Trial")</td>
                            <td class="text-end">
                                @if (b.CommissionId is int cid && b.Commission is decimal amount && amount > 0)
                                {
                                    @if (b.Status == CommissionStatus.Paid) { <span>@amount.ToString("N0") paid@(b.PaidReference is null ? "" : $", {b.PaidReference}")</span> }
                                    else
                                    {
                                        <form method="post" asp-action="MarkPaid" asp-route-commissionId="@cid" class="d-flex gap-1 justify-content-end m-0">
                                            <input type="hidden" name="partnerId" value="@p.Id" />
                                            <input name="reference" class="form-control form-control-sm" style="max-width: 130px" placeholder="M-PESA code" required />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Pay @amount.ToString("N0")</button>
                                        </form>
                                    }
                                }
                                else { <span class="text-body-secondary">—</span> }
                            </td>
                        </tr>
                    }
                    @if (Model.Businesses.Count == 0) { <tr><td colspan="4" class="small text-body-secondary">None yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="panel">
            <h2 class="panel-title mb-2">Details</h2>
            <form method="post" asp-action="Update" asp-route-id="@p.Id" class="row g-2">
                <div class="col-12"><label class="form-label small mb-1">Name</label><input name="name" value="@p.Name" class="form-control form-control-sm" required /></div>
                <div class="col-6"><label class="form-label small mb-1">Type</label>
                    <select name="kind" class="form-select form-select-sm">@foreach (var k in Enum.GetValues<PartnerKind>()) { <option value="@k" selected="@(p.Kind == k)">@k.Display()</option> }</select></div>
                <div class="col-6"><label class="form-label small mb-1">KES per paying customer</label><input name="commission" value="@p.CommissionPerCustomer.ToString("0.##")" class="form-control form-control-sm" inputmode="decimal" /></div>
                <div class="col-6"><label class="form-label small mb-1">Phone</label><input name="phone" value="@Model.Phone" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small mb-1">Email</label><input name="email" value="@Model.Email" class="form-control form-control-sm" /></div>
                <div class="col-12"><label class="form-label small mb-1">Notes</label><textarea name="notes" class="form-control form-control-sm" rows="2">@Model.Notes</textarea></div>
                <div class="col-12 form-check form-switch ms-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="p-active" name="isActive" value="true" checked="@p.IsActive" />
                    <input type="hidden" name="isActive" value="false" />
                    <label class="form-check-label" for="p-active">Active (new sign-ups can use the code)</label>
                </div>
                <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Save</button></div>
            </form>
        </section>
    </div>
</div>
