@model PartnerDetails
@{
    var p = Model.Partner;
    ViewData["Title"] = p.Name;
    var link = $"https://shambanyumba.com/?ref={p.Code}";
}
<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Partners</a>
<div class="page-head"><div class="me-auto"><h1 class="page-title">@p.Name</h1>
    <p class="page-sub">@p.Kind.Display()@(p.ReferrerBusinessName is null ? "" : $" · customer: {p.ReferrerBusinessName}")</p></div></div>

<section class="stat-strip mb-3">
    <div class="stat"><span class="stat-label">Code</span><span class="stat-value"><code>@p.Code</code></span></div>
    <div class="stat"><span class="stat-label">Signed up</span><span class="stat-value">@p.Trials</span></div>
    <div class="stat"><span class="stat-label">Paying customers</span><span class="stat-value">@p.Paying</span></div>
    <div class="stat"><span class="stat-label">Commission owed</span><span class="stat-value @(p.Owed > 0 ? "text-danger" : "")">KES @p.Owed.ToString("N0")</span><span class="stat-note">KES @p.Paid.ToString("N0") paid</span></div>
</section>

<section class="panel mb-3" id="share-kit">
    <h2 class="panel-title mb-2">Share kit for @p.Name</h2>
    @{
        var promoText = $"Manage your rentals and plot sales on your phone with ShambaNyumba: bill tenants in one click, track every payment, sell plots on instalments. From just KES 200 a month, and their team sets you up free. Use my code {p.Code}: {link}";
        var kitForPartner = $"Hi {p.Name.Split(' ')[0]}, here is your ShambaNyumba promoter kit.\n\nYour code: {p.Code}\nYour link: {link}\n\nAlways share the link or ask people to type your code when they create their business. That's how your customers (and your commission) are counted.\n\nReady-made post:\n{promoText}";
        var phone = Model.Phone is null ? null : new string(Model.Phone.Where(char.IsDigit).ToArray());
        if (phone is { Length: 10 } && phone.StartsWith("0")) phone = "254" + phone[1..];
    }
    <div class="row g-3 align-items-start">
        <div class="col-md-8">
            <label class="form-label small mb-1">Link</label>
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <code id="partner-link">@link</code>
                <button type="button" class="btn btn-sm btn-outline-primary" data-copy="#partner-link">Copy link</button>
            </div>
            <label class="form-label small mb-1" for="promo-text">Ready-made post (for their WhatsApp Status, Facebook, TikTok caption...)</label>
            <textarea id="promo-text" class="form-control form-control-sm mb-2" rows="4" readonly>@promoText</textarea>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-copy="#promo-text">Copy post</button>
                @if (phone is not null)
                {
                    <a class="btn btn-sm btn-success" target="_blank" rel="noopener" href="https://wa.me/@phone?text=@Uri.EscapeDataString(kitForPartner)"><i class="bi bi-whatsapp me-1"></i>Send kit to @p.Name.Split(' ')[0] on WhatsApp</a>
                }
                else
                {
                    <span class="small text-body-secondary align-self-center">Add their phone below to send the kit on WhatsApp.</span>
                }
            </div>
            <p class="form-text mb-0">Visitors from the link are remembered for 60 days; people can also type the code when creating their business. Posters: give them the WhatsApp Status posters plus this QR code.</p>
        </div>
        <div class="col-md-4 text-center">
            <div id="partner-qr" class="partner-qr" aria-label="QR code for @link"></div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="qr-download">Download QR code</button>
        </div>
    </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    (function () {
        document.querySelectorAll('[data-copy]').forEach(function (b) {
            b.addEventListener('click', function () {
                var el = document.querySelector(b.dataset.copy);
                var text = el.value !== undefined ? el.value : el.textContent;
                if (navigator.clipboard) navigator.clipboard.writeText(text);
                b.textContent = 'Copied';
            });
        });
        var box = document.getElementById('partner-qr');
        if (window.QRCode) new QRCode(box, { text: '@link', width: 200, height: 200, colorDark: '#0B2A4A', colorLight: '#ffffff' });
        document.getElementById('qr-download').addEventListener('click', function () {
            var canvas = box.querySelector('canvas'), img = box.querySelector('img');
            var a = document.createElement('a');
            a.href = canvas ? canvas.toDataURL('image/png') : img.src;
            a.download = 'ShambaNyumba-QR-@(p.Code).png';
            a.click();
        });
    })();
</script>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="panel p-0">
            <div class="units-toolbar"><h2 class="panel-title">Businesses they brought</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-stack">
                    <thead><tr><th>Business</th><th>Started</th><th>Status</th><th class="text-end">Commission</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Businesses)
                    {
                        <tr>
                            <td class="fw-semibold">@b.Name</td>
                            <td>@b.CreatedAtUtc.ToEatDate()</td>
                            <td>@(b.Paying ? "Paying" : "Setup period: follow up")</td>
                            <td class="text-end">
                                @if (b.CommissionId is int cid && b.Commission is decimal amount && amount > 0)
                                {
                                    @if (b.Status == CommissionStatus.Paid) { <span>@amount.ToString("N0") paid@(b.PaidReference is null ? "" : $", {b.PaidReference}")</span> }
                                    else
                                    {
                                        <form method="post" asp-action="MarkPaid" asp-route-commissionId="@cid" class="d-flex gap-1 justify-content-end m-0">
                                            <input type="hidden" name="partnerId" value="@p.Id" />
                                            <input name="reference" class="form-control form-control-sm" style="max-width: 130px" placeholder="M-PESA code" required />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Pay @amount.ToString("N0")</button>
                                        </form>
                                    }
                                }
                                else { <span class="text-body-secondary">—</span> }
                            </td>
                        </tr>
                    }
                    @if (Model.Businesses.Count == 0) { <tr><td colspan="4" class="small text-body-secondary">None yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="panel">
            <h2 class="panel-title mb-2">Details</h2>
            <form method="post" asp-action="Update" asp-route-id="@p.Id" class="row g-2">
                <div class="col-12"><label class="form-label small mb-1">Name</label><input name="name" value="@p.Name" class="form-control form-control-sm" required /></div>
                <div class="col-6"><label class="form-label small mb-1">Type</label>
                    <select name="kind" class="form-select form-select-sm">@foreach (var k in Enum.GetValues<PartnerKind>()) { <option value="@k" selected="@(p.Kind == k)">@k.Display()</option> }</select></div>
                <div class="col-6"><label class="form-label small mb-1">KES per paying customer</label><input name="commission" value="@p.CommissionPerCustomer.ToString("0.##")" class="form-control form-control-sm" inputmode="decimal" /></div>
                <div class="col-6"><label class="form-label small mb-1">Phone</label><input name="phone" value="@Model.Phone" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small mb-1">Email</label><input name="email" value="@Model.Email" class="form-control form-control-sm" /></div>
                <div class="col-12"><label class="form-label small mb-1">Notes</label><textarea name="notes" class="form-control form-control-sm" rows="2">@Model.Notes</textarea></div>
                <div class="col-12 form-check form-switch ms-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="p-active" name="isActive" value="true" checked="@p.IsActive" />
                    <input type="hidden" name="isActive" value="false" />
                    <label class="form-check-label" for="p-active">Active (new sign-ups can use the code)</label>
                </div>
                <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Save</button></div>
            </form>
        </section>
    </div>
</div>
