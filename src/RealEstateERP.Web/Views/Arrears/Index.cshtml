@model ArrearsIndexViewModel
@{
    ViewData["Title"] = "Arrears";
    var r = Model.Report;
    var t = r.Totals;
    decimal Pct(decimal part) => t.Total == 0 ? 0 : Math.Round(part * 100 / t.Total, 1);
    string Inv(decimal v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <div class="me-auto">
        <h1 class="page-title">Arrears</h1>
        <p class="page-sub">Overdue balances by how late they are. @r.Tenants.Count tenant(s) behind.</p>
    </div>
    @if (Model.CanEdit && Model.PenaltiesDue > 0)
    {
        <a asp-action="Penalties" class="btn btn-primary"><i class="bi bi-exclamation-octagon me-1"></i>Late penalties due (@Model.PenaltiesDue)</a>
    }
</div>

<section class="stat-strip mb-3" aria-label="Overdue by age">
    <div class="stat"><span class="stat-label">1-30 days</span><span class="stat-value">@t.Days1To30.Kes()</span></div>
    <div class="stat"><span class="stat-label">31-60 days</span><span class="stat-value">@t.Days31To60.Kes()</span></div>
    <div class="stat"><span class="stat-label">61-90 days</span><span class="stat-value">@t.Days61To90.Kes()</span></div>
    <div class="stat"><span class="stat-label">Over 90 days</span><span class="stat-value @(t.Over90 > 0 ? "text-danger" : "")">@t.Over90.Kes()</span></div>
</section>

@if (t.Total > 0)
{
    <div class="aging-bar mb-1" role="img" aria-label="Overdue split by age">
        <span class="age-1" style="width: @Inv(Pct(t.Days1To30))%"></span>
        <span class="age-2" style="width: @Inv(Pct(t.Days31To60))%"></span>
        <span class="age-3" style="width: @Inv(Pct(t.Days61To90))%"></span>
        <span class="age-4" style="width: @Inv(Pct(t.Over90))%"></span>
    </div>
}
<p class="small text-body-secondary mb-3">Total overdue <strong>@t.Total.Kes()</strong>. A further @r.NotYetDue.Kes() is invoiced but not yet due.</p>

@if (r.ByProperty.Count > 1)
{
    <section class="panel p-0 mb-3">
        <div class="units-toolbar"><h2 class="panel-title">By property</h2></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Property</th><th class="text-end">Tenants</th><th class="text-end">1-30</th><th class="text-end">31-60</th><th class="text-end">61-90</th><th class="text-end">90+</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                @foreach (var p in r.ByProperty)
                {
                    <tr>
                        <td class="fw-semibold"><a asp-action="Index" asp-route-assetId="@p.AssetId" class="row-link">@p.AssetName</a></td>
                        <td class="text-end">@p.TenantCount</td>
                        <td class="text-end">@p.Aging.Days1To30.ToString("N0")</td>
                        <td class="text-end">@p.Aging.Days31To60.ToString("N0")</td>
                        <td class="text-end">@p.Aging.Days61To90.ToString("N0")</td>
                        <td class="text-end">@p.Aging.Over90.ToString("N0")</td>
                        <td class="text-end fw-semibold">@p.Aging.Total.Kes()</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="panel p-0">
    <div class="units-toolbar">
        <h2 class="panel-title me-auto">Tenants behind on payments</h2>
        <form method="get" class="d-flex flex-wrap gap-2">
            <select name="assetId" class="form-select form-select-sm" aria-label="Property" onchange="this.form.submit()">
                <option value="">All properties</option>
                @foreach (var a in Model.Assets) { <option value="@a.Id" selected="@(Model.AssetId == a.Id)">@a.Name</option> }
            </select>
            <select name="stage" class="form-select form-select-sm" aria-label="Collections stage" onchange="this.form.submit()">
                <option value="">Any stage</option>
                @foreach (var s in Enum.GetValues<CollectionStage>()) { <option value="@s" selected="@(Model.Stage == s)">@s.Display()</option> }
            </select>
        </form>
    </div>
    @if (r.Tenants.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-emoji-smile" aria-hidden="true"></i>
            <h3 class="h6">Nobody is behind</h3>
            <p>Every issued invoice is paid or not yet due.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Tenant</th><th>Stage</th><th class="text-end">Oldest</th><th class="text-end">1-30</th><th class="text-end">31-60</th><th class="text-end">61-90</th><th class="text-end">90+</th><th class="text-end">Overdue</th><th>Last paid</th></tr></thead>
                <tbody>
                @foreach (var x in r.Tenants)
                {
                    <tr>
                        <td>
                            <a asp-controller="Tenants" asp-action="Details" asp-route-id="@x.TenantId" class="row-link fw-semibold">@x.TenantName</a>
                            <div class="small text-body-secondary">@x.Units@(x.Phone is null ? "" : $", {RealEstateERP.Core.Common.KenyanPhone.Display(x.Phone)}")</div>
                        </td>
                        <td><partial name="_CollectionStageChip" model="x.Stage" /></td>
                        <td class="text-end text-nowrap">@x.OldestDaysOverdue days</td>
                        <td class="text-end">@(x.Aging.Days1To30 > 0 ? x.Aging.Days1To30.ToString("N0") : "")</td>
                        <td class="text-end">@(x.Aging.Days31To60 > 0 ? x.Aging.Days31To60.ToString("N0") : "")</td>
                        <td class="text-end">@(x.Aging.Days61To90 > 0 ? x.Aging.Days61To90.ToString("N0") : "")</td>
                        <td class="text-end text-danger">@(x.Aging.Over90 > 0 ? x.Aging.Over90.ToString("N0") : "")</td>
                        <td class="text-end fw-semibold text-nowrap">@x.Aging.Total.Kes()@if (x.Credit > 0) { <div class="small text-body-secondary fw-normal">@x.Credit.Kes() credit unapplied</div> }</td>
                        <td class="text-nowrap small">@(x.LastPaymentDate?.ToString("d MMM yyyy") ?? "Never")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
