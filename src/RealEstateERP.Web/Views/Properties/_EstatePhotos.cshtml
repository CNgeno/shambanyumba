@model EstatePanelModel
<section class="panel mb-3" id="estate-photos">
    <h2 class="panel-title mb-1">Photos and description</h2>
    <p class="small text-body-secondary">Shown on this estate's listings. Add interiors per unit from each unit's menu.</p>
    @if (Model.Photos.Count > 0)
    {
        <div class="estate-gallery mb-2">
            @foreach (var p in Model.Photos)
            {
                <figure class="m-0">
                    <img src="@Url.Action("Photo", "Estate", new { kind = "estate", id = p.Id })" alt="@p.FileName" loading="lazy" />
                    @if (Model.CanEdit)
                    {
                        <form method="post" asp-controller="Estate" asp-action="RemovePhoto" asp-route-assetId="@Model.AssetId" asp-route-photoId="@p.Id" class="gallery-remove" onsubmit="return confirm('Remove this photo?');">
                            <button type="submit" class="btn btn-sm btn-light" aria-label="Remove photo"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                </figure>
            }
        </div>
    }
    @if (Model.CanEdit)
    {
        <form method="post" asp-controller="Estate" asp-action="AddPhotos" asp-route-assetId="@Model.AssetId" enctype="multipart/form-data" class="mb-3">
            <input type="file" name="files" accept=".jpg,.jpeg,.png" multiple class="form-control form-control-sm mb-2" required />
            <button type="submit" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-camera me-1"></i>Upload estate photos</button>
            <div class="form-text">JPG or PNG, up to 12. Daylight photos of the gate, compound and outside get the most enquiries.</div>
        </form>
        <form method="post" asp-controller="Estate" asp-action="Description" asp-route-assetId="@Model.AssetId">
            <label class="form-label small mb-1" for="estate-desc">About the estate (for listings)</label>
            <textarea id="estate-desc" name="description" rows="4" maxlength="1000" class="form-control form-control-sm mb-2"
                      placeholder="e.g. Quiet gated estate 5 minutes from the stage. Borehole and county water, tokens, 24-hour security, parking.">@Model.Description</textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Save description</button>
        </form>
    }
    else if (Model.Description is not null)
    {
        <p class="small mb-0">@Model.Description</p>
    }
</section>
