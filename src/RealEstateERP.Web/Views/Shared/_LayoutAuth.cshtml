@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Hosting
@using RealEstateERP.Infrastructure.Data
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@{
    var showDemoLogins = Env.IsDevelopment()
        && Config.GetValue<bool>("DemoData:Enabled")
        && Context.Request.Path.StartsWithSegments("/Identity/Account/Login");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | ShambaNyumba</title>
    <link rel="icon" href="/img/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B2A4A" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-wrap">
        <a class="auth-brand text-reset text-decoration-none" href="/" aria-label="ShambaNyumba home">
            <img src="/img/brand/shambanyumba-logo.svg" alt="ShambaNyumba, Real Estate Manager" class="brand-lockup" width="210" height="46" />
        </a>
        <div class="auth-card">
            @RenderBody()
        </div>

        @if (showDemoLogins)
        {
            <aside class="demo-logins" aria-label="Demo accounts">
                <p class="fw-semibold mb-1"><i class="bi bi-wrench-adjustable me-1"></i>Demo accounts (Development only)</p>
                <p class="small text-body-secondary mb-2">Password for all: <code>@(Config["DemoData:Password"] ?? "Demo@12345")</code>. Click an email to fill it in.
                    Emails the app sends land in the <a href="/dev/mailbox" target="_blank">dev mailbox</a>.</p>
                <ul class="list-unstyled mb-0">
                    @foreach (var a in DemoAccounts.All)
                    {
                        <li>
                            <button type="button" class="btn btn-link btn-sm p-0 demo-fill" data-email="@a.Email" data-password="@(Config["DemoData:Password"] ?? "Demo@12345")">@a.Email</button>
                            <span class="small text-body-secondary">: @a.Description</span>
                        </li>
                    }
                </ul>
            </aside>
            <script>
                document.querySelectorAll('.demo-fill').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var email = document.querySelector('input[type="email"], input[name$="Email"]');
                        var pwd = document.querySelector('input[type="password"]');
                        if (email) email.value = btn.dataset.email;
                        if (pwd) pwd.value = btn.dataset.password;
                        if (pwd) pwd.focus();
                    });
                });
            </script>
        }
    </main>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.togglePassword);
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
