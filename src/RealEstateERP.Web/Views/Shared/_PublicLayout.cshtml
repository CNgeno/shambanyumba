@using RealEstateERP.Core.Constants
@using RealEstateERP.Core.Interfaces
@inject ISystemConfigService Config
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var overHero = ViewData["NavOverHero"] is true;
    string Active(string name) => string.Equals(action, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var supportEmail = await Config.GetAsync(ConfigKeys.SupportEmail);
    var supportPhone = await Config.GetAsync(ConfigKeys.SupportPhone);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | ShambaNyumba</title>
    <link rel="icon" href="/img/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B2A4A" />
    <meta property="og:site_name" content="ShambaNyumba" />
    <meta property="og:title" content="@ViewData["Title"] | ShambaNyumba" />
    @* Pages can override the link preview (e.g. a listing shows its own photo, title and price). *@
    <meta property="og:description" content="@(ViewData["OgDescription"] as string ?? "Real Estate Manager: rentals and plot sales, without the paperwork. Bill tenants, sell plots on instalments, and know your margins.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] as string ?? "https://shambanyumba.com/img/brand/share-1200x630.png")" />
    @if (ViewData["OgUrl"] is string ogUrl) { <meta property="og:url" content="@ogUrl" /> }
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="description" content="@(ViewData["Description"] ?? "Property management software for Kenyan landlords, agencies and developers: tenants, leases, invoices, payments and arrears in one place.")" />
    <meta name="theme-color" content="#0b2a4a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
<body class="public-body @(overHero ? "has-hero" : "")">
<header class="site-header" id="site-header">
    @* One strip: contact (left), announcement (centre), Kenya (right). Inside the header so the fixed hero header never covers it. *@
    <div class="info-strip">
        <div class="container info-strip-row">
            <span class="info-side d-none d-xl-flex">
                @if (!string.IsNullOrWhiteSpace(supportEmail))
                {
                    <a href="mailto:@supportEmail"><i class="bi bi-envelope"></i>@supportEmail</a>
                }
                @if (!string.IsNullOrWhiteSpace(supportPhone))
                {
                    <a href="tel:@(supportPhone.Replace(" ", string.Empty))"><i class="bi bi-telephone"></i>@supportPhone</a>
                }
            </span>
            <span class="announce" role="region" aria-label="Announcement">
                <span class="announce-new">New</span>
                <span class="d-none d-sm-inline">See ShambaNyumba in action:</span>
                <a href="/tour">take the 3-minute tour</a>
                <span>or</span>
                <form method="post" asp-area="" asp-controller="Demo" asp-action="Start" class="d-inline m-0"><button type="submit" class="announce-link">try the live demo</button></form>
                <span class="d-none d-lg-inline">or</span>
                <a href="/downloads/ShambaNyumba-Walkthrough.pdf" class="d-none d-lg-inline" download>download the walkthrough (PDF)</a>
            </span>
            <span class="info-side info-side-right d-none d-xl-flex"><i class="bi bi-geo-alt"></i>Built for property in Kenya</span>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg site-nav" aria-label="Main">
        <div class="container">
            <a class="site-logo" asp-controller="Home" asp-action="Index" aria-label="ShambaNyumba home">
                <img src="/img/brand/shambanyumba-logo-dark.svg" alt="ShambaNyumba, Real Estate Manager" class="brand-lockup" width="190" height="41" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-menu" aria-controls="site-menu" aria-expanded="false" aria-label="Open menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="collapse navbar-collapse" id="site-menu">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @Active("Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Tour" ? "active" : "")" href="/tour">Tour</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PropertiesPublic" ? "active" : "")" href="/marketplace">Find a property</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Features")" asp-controller="Home" asp-action="Features">Features</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Pricing")" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link @Active("About")" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Contact")" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
                <div class="site-nav-actions">
                    @if (signedIn)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-accent"><i class="bi bi-grid me-1"></i>Open dashboard</a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="nav-link nav-signin">Sign in</a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent">Start free trial</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main id="main-content">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <a class="site-logo mb-3" asp-controller="Home" asp-action="Index">
                    <img src="/img/brand/shambanyumba-logo-dark.svg" alt="ShambaNyumba, Real Estate Manager" class="brand-lockup" width="190" height="41" />
                </a>
                <p class="footer-about">Software for landlords, agencies and developers: rentals, plot and house sales, development costs and listings in one place.</p>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <h2 class="footer-title">Product</h2>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Features">Features</a></li>
                    <li><a asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                    <li><a href="/marketplace?type=Rent">Homes to let</a></li>
                    <li><a href="/marketplace?type=Sale">Plots and homes for sale</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <h2 class="footer-title">Company</h2>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    <li><a asp-controller="Home" asp-action="Terms">Terms</a></li>
                </ul>
            </div>
            <div class="col-md-4 col-lg-3">
                <h2 class="footer-title">Get started</h2>
                <ul class="footer-links">
                    <li><a asp-area="Identity" asp-page="/Account/Register">Start a free trial</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
                    @if (!string.IsNullOrWhiteSpace(supportEmail)) { <li><a href="mailto:@supportEmail">@supportEmail</a></li> }
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year ShambaNyumba</span>
            <span>Made in Kenya</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Over the hero the header starts transparent and turns solid once you scroll (or open the mobile menu).
    (function () {
        var header = document.getElementById('site-header');
        if (!document.body.classList.contains('has-hero')) return;
        var menu = document.getElementById('site-menu');
        function update() { header.classList.toggle('is-solid', window.scrollY > 40 || menu.classList.contains('show')); }
        window.addEventListener('scroll', update, { passive: true });
        menu.addEventListener('show.bs.collapse', function () { header.classList.add('is-solid'); });
        menu.addEventListener('hidden.bs.collapse', update);
        update();
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
