@inject RealEstateERP.Core.Interfaces.ICapabilityService Capabilities
@using System.Security.Claims
@using RealEstateERP.Core.Constants
@inject RealEstateERP.Core.Interfaces.IAgentScopeService AgentScope
@inject RealEstateERP.Core.Interfaces.IListingService ListingsService
@{
    var businessName = User.FindFirstValue(AppClaimTypes.BusinessName);
    var hasBusiness = businessName is not null;
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
    var isBusinessAdmin = User.FindFirstValue(AppClaimTypes.BusinessRole) is "Owner" or "Admin";
    var businessType = User.FindFirstValue(AppClaimTypes.BusinessType);
    // Menus follow what the business does: its properties (to let / for sale) and the agency setting.
    var caps = User.FindFirstValue(AppClaimTypes.BusinessId) is null ? RealEstateERP.Core.Interfaces.Capabilities.None : await Capabilities.GetAsync();
    var rentals = caps.Rentals;
    // A business that both lets and sells sees the group for what it's doing now: selling pages (and a property
    // for sale) show Selling, letting pages (and a property to let) show Letting, shared pages show both.
    var controllerName = ViewContext.RouteData.Values["controller"] as string ?? "";
    var doesBoth = caps.Rentals && caps.Sales;
    string? workspace = !doesBoth ? null
        : ViewData["Workspace"] is string ws ? ws
        : controllerName is "Tenants" or "Leases" or "Invoices" or "Payments" or "Arrears" or "Readings" or "Charges" or "Reports" or "Estate" ? "Letting"
        : controllerName is "Sales" or "Buyers" or "Costing" ? "Selling"
        : controllerName == "Properties" && ViewData["Project"] is not null ? "Selling"
        : controllerName == "Properties" && ViewData["Estate"] is not null ? "Letting"
        : null;
    var showLetting = caps.Rentals && workspace != "Selling";
    var finances = User.FindFirstValue(AppClaimTypes.BusinessId) is not null && await Capabilities.CanViewFinancialsAsync();
    var showSelling = caps.Sales && workspace != "Letting";
    var agentScope = businessType == "Agency" ? await AgentScope.GetAsync() : RealEstateERP.Core.Models.AgentScope.None;
    var isAgent = agentScope.IsRestricted;
    var newLeads = businessType is not null ? await ListingsService.CountNewLeadsAsync() : 0;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayName = User.DisplayName();
    var hideBanner = ViewData["HideSubscriptionBanner"] is true;
    bool IsOn(string[] names) => names.Any(n => string.Equals(controller, n, StringComparison.OrdinalIgnoreCase));
    string Active(params string[] names) => IsOn(names) ? "active" : "";
    string Current(params string[] names) => IsOn(names) ? "page" : "false";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | @(businessName ?? "ShambaNyumba")</title>
    <link rel="icon" href="/img/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B2A4A" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell">
    <aside class="sidebar offcanvas-lg offcanvas-start" id="sidebar" tabindex="-1" aria-label="Main navigation">
        <div class="sidebar-inner">
            <div class="sidebar-brand">
                <img src="/img/brand/shambanyumba-logo-dark.svg" alt="ShambaNyumba" class="brand-lockup brand-lockup-sidebar" width="170" height="37" />
                <button type="button" class="btn-close btn-close-white d-lg-none ms-auto" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close menu"></button>
            </div>

            @if (hasBusiness)
            {
                @await Component.InvokeAsync("BusinessSwitcher")
            }

            <nav class="sidebar-nav">
                @if (hasBusiness)
                {
                    <a class="side-link @Active("Dashboard")" aria-current="@Current("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i>Dashboard</a>

                    <a class="side-link @Active("Properties", "Units")" aria-current="@Current("Properties", "Units")" asp-area="" asp-controller="Properties" asp-action="Index"><i class="bi bi-buildings"></i>Properties</a>

                    @* Groups by activity. Each appears only when the business does it: Letting (a property to let),
                       Selling (a property for sale), Agency (managing for other owners, on a plan that includes it). *@
                    @if (doesBoth)
                    {
                        <div class="workspace-switch" role="group" aria-label="Show menus for">
                            <a asp-area="" asp-controller="Leases" asp-action="Index" class="@(workspace == "Letting" ? "is-active" : "")" aria-current="@(workspace == "Letting" ? "true" : null)">Letting</a>
                            <a asp-area="" asp-controller="Sales" asp-action="Index" class="@(workspace == "Selling" ? "is-active" : "")" aria-current="@(workspace == "Selling" ? "true" : null)">Selling</a>
                        </div>
                    }
                    @if (showLetting)
                    {
                        <p class="side-group">Letting</p>
                        <a class="side-link @Active("Tenants")" aria-current="@Current("Tenants")" asp-area="" asp-controller="Tenants" asp-action="Index"><i class="bi bi-people"></i>Tenants</a>
                        <a class="side-link @Active("Leases")" aria-current="@Current("Leases")" asp-area="" asp-controller="Leases" asp-action="Index"><i class="bi bi-file-earmark-text"></i>Leases</a>
                        <a class="side-link @Active("Invoices")" aria-current="@Current("Invoices")" asp-area="" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i>Invoices</a>
                        <a class="side-link @Active("Payments")" aria-current="@Current("Payments")" asp-area="" asp-controller="Payments" asp-action="Index"><i class="bi bi-cash-coin"></i>Payments</a>
                        <a class="side-link @Active("Arrears")" aria-current="@Current("Arrears")" asp-area="" asp-controller="Arrears" asp-action="Index"><i class="bi bi-exclamation-diamond"></i>Arrears</a>
                        <a class="side-link @Active("Readings")" aria-current="@Current("Readings")" asp-area="" asp-controller="Readings" asp-action="Index"><i class="bi bi-speedometer"></i>Meter readings</a>
                        <a class="side-link @Active("Charges")" aria-current="@Current("Charges")" asp-area="" asp-controller="Charges" asp-action="Index"><i class="bi bi-tags"></i>Charges</a>
                        @if (finances)
                        {
                            <a class="side-link @Active("Reports")" aria-current="@Current("Reports")" asp-area="" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Rent reports</a>
                        }
                        @if (finances && caps.HasProperties)
                        {
                            <a class="side-link @Active("Costing")" aria-current="@Current("Costing")" asp-area="" asp-controller="Costing" asp-action="Index"><i class="bi bi-calculator"></i>Costs and yield</a>
                        }
                    }

                    @if (showSelling)
                    {
                        <p class="side-group">Selling</p>
                        <a class="side-link @Active("Sales")" aria-current="@Current("Sales")" asp-area="" asp-controller="Sales" asp-action="Index"><i class="bi bi-house-check"></i>@(isAgent ? "My sales" : "Sales")</a>
                        <a class="side-link @Active("Buyers")" aria-current="@Current("Buyers")" asp-area="" asp-controller="Buyers" asp-action="Index"><i class="bi bi-person-check"></i>Buyers</a>
                        @if (finances)
                        {
                            <a class="side-link @Active("Costing")" aria-current="@Current("Costing")" asp-area="" asp-controller="Costing" asp-action="Index"><i class="bi bi-calculator"></i>Costs and margins</a>
                            <a class="side-link" asp-area="" asp-controller="Sales" asp-action="Reports"><i class="bi bi-bar-chart"></i>Sales reports</a>
                        }
                    }

                    @if (caps.Agency)
                    {
                        <p class="side-group">Agency</p>
                        <a class="side-link @Active("Owners")" aria-current="@Current("Owners")" asp-area="" asp-controller="Owners" asp-action="Index"><i class="bi bi-person-badge"></i>Owners</a>
                        <a class="side-link @Active("Contracts")" aria-current="@Current("Contracts")" asp-area="" asp-controller="Contracts" asp-action="Index"><i class="bi bi-file-earmark-ruled"></i>@(isAgent ? "My contracts" : "Contracts")</a>
                        <a class="side-link @Active("Remittances")" aria-current="@Current("Remittances")" asp-area="" asp-controller="Remittances" asp-action="Index"><i class="bi bi-send-check"></i>Owner statements</a>
                        @if (isAgent)
                        {
                            <a class="side-link" asp-area="" asp-controller="Remittances" asp-action="AgentCommissions"><i class="bi bi-cash-coin"></i>My commission</a>
                        }
                        else
                        {
                            <a class="side-link @Active("Agents")" aria-current="@Current("Agents")" asp-area="" asp-controller="Agents" asp-action="Index"><i class="bi bi-person-workspace"></i>Agents</a>
                        }
                    }

                    <p class="side-group">Marketplace</p>
                    <a class="side-link @Active("Listings")" aria-current="@Current("Listings")" asp-area="" asp-controller="Listings" asp-action="Index"><i class="bi bi-megaphone"></i>Listings</a>
                    <a class="side-link @Active("Leads")" aria-current="@Current("Leads")" asp-area="" asp-controller="Leads" asp-action="Index"><i class="bi bi-person-lines-fill"></i>Leads
                        @if (newLeads > 0) { <span class="side-badge" aria-label="@newLeads new">@newLeads</span> }</a>

                    <p class="side-group">Account</p>
                    <a class="side-link @Active("Subscription")" aria-current="@Current("Subscription")" asp-area="" asp-controller="Subscription" asp-action="Index"><i class="bi bi-credit-card"></i>Subscription</a>
                    <a class="side-link @Active("Credits")" aria-current="@Current("Credits")" asp-area="" asp-controller="Credits" asp-action="Index"><i class="bi bi-coin"></i>Credits</a>
                    @if (isBusinessAdmin)
                    {
                        <a class="side-link @Active("BusinessSettings")" aria-current="@Current("BusinessSettings")" asp-area="" asp-controller="BusinessSettings" asp-action="Index"><i class="bi bi-gear"></i>Business settings</a>
                    }
                }
                else
                {
                    <a class="side-link" asp-area="" asp-controller="Business" asp-action="Select"><i class="bi bi-buildings"></i>Choose a business</a>
                }

                @if (isSuperAdmin)
                {
                    <p class="side-group">Platform</p>
                    <a class="side-link @Active("AdminSubscriptions")" aria-current="@Current("AdminSubscriptions")" asp-area="" asp-controller="AdminSubscriptions" asp-action="Index"><i class="bi bi-patch-check"></i>Payment approvals</a>
                    <a class="side-link @Active("AdminReports")" aria-current="@Current("AdminReports")" asp-area="" asp-controller="AdminReports" asp-action="Index"><i class="bi bi-graph-up"></i>Platform reports</a>
                <a class="side-link @Active("AdminBusinesses")" aria-current="@Current("AdminBusinesses")" asp-area="" asp-controller="AdminBusinesses" asp-action="Index"><i class="bi bi-buildings"></i>Businesses</a>
                <a class="side-link @Active("AdminUsers")" aria-current="@Current("AdminUsers")" asp-area="" asp-controller="AdminUsers" asp-action="Index"><i class="bi bi-person-badge"></i>Users</a>
                <a class="side-link @Active("AdminCredits")" aria-current="@Current("AdminCredits")" asp-area="" asp-controller="AdminCredits" asp-action="Index"><i class="bi bi-coin"></i>Credit purchases</a>
                <a class="side-link @Active("AdminPlans")" aria-current="@Current("AdminPlans")" asp-area="" asp-controller="AdminPlans" asp-action="Index"><i class="bi bi-layers"></i>Plans</a>
                    <a class="side-link @Active("AdminPartners")" aria-current="@Current("AdminPartners")" asp-area="" asp-controller="AdminPartners" asp-action="Index"><i class="bi bi-people"></i>Partners and referrals</a>
                    <a class="side-link @Active("AdminSettings")" aria-current="@Current("AdminSettings")" asp-area="" asp-controller="AdminSettings" asp-action="Index"><i class="bi bi-sliders"></i>Settings</a>
                }
            </nav>

            <div class="sidebar-foot">
                <a class="side-link" asp-area="" asp-controller="Home" asp-action="Contact"><i class="bi bi-question-circle"></i>Help and support</a>
            </div>
        </div>
    </aside>

    <div class="main">
        @if (RealEstateERP.Core.Constants.DemoUsers.IsDemo(User.Identity?.Name))
        {
            <div class="demo-bar" role="status">
                <i class="bi bi-eye"></i>
                <span><strong>Live demo.</strong> Anyone can see this and it resets every night. Don't enter real personal information.</span>
                <a href="/Identity/Account/Register" class="btn btn-sm btn-light ms-auto">Start your own free trial</a>
            </div>
        }
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-context">
                @if (hasBusiness)
                {
                    <span class="d-none d-sm-inline text-body-secondary">@businessName</span>
                    <i class="bi bi-chevron-right d-none d-sm-inline text-body-secondary small" aria-hidden="true"></i>
                }
                <span class="fw-semibold">@ViewData["Title"]</span>
            </div>

            <div class="topbar-actions ms-auto">
            @await Component.InvokeAsync("NotificationBell")
            <div class="dropdown">
                <button class="user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar" aria-hidden="true">@UserDisplay.Initials(displayName)</span>
                    <span class="d-none d-md-inline text-truncate user-name">@displayName</span>
                    <i class="bi bi-chevron-down small d-none d-md-inline" aria-hidden="true"></i>
                    <span class="visually-hidden">Account menu</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end user-menu">
                    <li class="px-3 py-2">
                        <div class="fw-semibold text-truncate">@displayName</div>
                        <div class="small text-body-secondary text-truncate">@User.Identity?.Name</div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-gear me-2"></i>Your account</a></li>
                    @if (isBusinessAdmin)
                    {
                        <li><a class="dropdown-item" asp-area="" asp-controller="BusinessSettings" asp-action="Team"><i class="bi bi-people me-2"></i>Team</a></li>
                    }
                    <li><a class="dropdown-item" asp-area="" asp-controller="Business" asp-action="Select"><i class="bi bi-arrow-left-right me-2"></i>Switch business</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="m-0">
                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                        </form>
                    </li>
                </ul>
            </div>
            </div>
        </header>

        <main class="content" id="main-content">
            <partial name="_BackBar" />
            @if (!hideBanner)
            {
                @await Component.InvokeAsync("SubscriptionBanner")
            }

            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2" aria-hidden="true"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
