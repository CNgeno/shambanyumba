@model RentalCard
@{
    var c = Model;
}
<article class="panel project-card">
    <div class="d-flex align-items-start gap-2 mb-2">
        <div class="me-auto">
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@c.AssetId" class="row-link fw-semibold">@c.Name</a>
            <div class="small text-body-secondary">@c.Type.Display()@(c.Location is null ? "" : $", {c.Location}") · to let</div>
        </div>
        @if (c.Units > 0) { <span class="status-chip @(c.Vacant == 0 ? "status-ok" : "status-neutral")">@c.OccupancyPercent% let</span> }
    </div>

    @if (c.Units == 0)
    {
        <p class="small text-body-secondary mb-2">Next: add the units with their rent.</p>
    }
    else
    {
        <div class="plot-bar mb-1" role="img" aria-label="@c.Occupied let, @c.Vacant vacant of @c.Units units">
            <span class="pb-sold" style="width: @(c.Occupied * 100 / c.Units)%"></span>
        </div>
        <div class="small mb-2"><strong>@c.Occupied</strong> let · <strong>@c.Vacant</strong> vacant of @c.Units · rent roll @c.RentRoll.Kes()</div>
    }

    <dl class="project-figures mb-2">
        <div><dt>Invoiced this month</dt><dd>@c.Invoiced.Kes()</dd></div>
        <div><dt>Collected this month</dt><dd>@c.Collected.Kes()@(c.Invoiced > 0 ? $" ({c.CollectedPercent}%)" : "")</dd></div>
        <div><dt>Overdue</dt><dd class="@(c.Overdue > 0 ? "text-danger fw-semibold" : "")">@c.Overdue.Kes()</dd></div>
        @if (c.NetThisMonth is decimal net)
        {
            <div><dt>Net this month</dt><dd class="@(net < 0 ? "text-danger fw-semibold" : "")" title="Collected less running costs">@net.Kes()</dd></div>
        }
        else
        {
            <div><dt>Vacant rent</dt><dd>@((c.RentRoll - c.OccupiedRent).Kes())</dd></div>
        }
    </dl>
    @if (c.NextStep is not null)
    {
        <p class="small mb-2"><i class="bi bi-signpost me-1"></i>Setup: @c.NextStep</p>
    }
    else if (c.OverdueInvoices > 0)
    {
        <p class="small mb-2 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>@c.OverdueInvoices invoice(s) overdue</p>
    }
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@c.AssetId" class="btn btn-sm btn-outline-primary">@(c.NextStep is null ? "Open" : "Continue setup")</a>
        @if (c.Occupied > 0)
        {
            <a asp-controller="Payments" asp-action="Record" class="btn btn-sm btn-outline-primary">Record payment</a>
            @if (c.Overdue > 0) { <a asp-controller="Arrears" asp-action="Index" class="btn btn-sm btn-outline-danger">Arrears</a> }
        }
    </div>
</article>
