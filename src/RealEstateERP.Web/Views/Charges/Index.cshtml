@model IReadOnlyList<ChargeDefinition>
@{
    ViewData["Title"] = "Charges";
    var canAdmin = ViewData["CanAdmin"] is true;
}
<div class="page-head">
    <div class="me-auto">
        <h1 class="page-title">Charges</h1>
        <p class="page-sub">The charges you bill on top of rent. Attach them to leases from each lease's page.</p>
    </div>
    @if (canAdmin)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add charge</a>
    }
</div>

@if (Model.Count == 0)
{
    <section class="panel empty-state">
        <i class="bi bi-tags" aria-hidden="true"></i>
        <h2 class="h5">No charges yet</h2>
        <p>Common ones: garbage collection and security (fixed monthly), water and electricity (metered), service charge for shops.</p>
        @if (canAdmin)
        {
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-action="Create" asp-route-type="Recurring" class="btn btn-primary">Add a monthly charge</a>
                <a asp-action="Create" asp-route-type="Utility" class="btn btn-outline-primary">Add a metered utility</a>
            </div>
        }
    </section>
}
else
{
    <section class="panel p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Charge</th><th>Type</th><th class="text-end">Price</th><th class="text-end">Tax</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(c.IsActive ? "" : "text-body-secondary")">
                        <td class="fw-semibold">@c.Name @if (c.Description is not null) { <div class="small text-body-secondary fw-normal">@c.Description</div> }</td>
                        <td>@c.Type.Display()</td>
                        <td class="text-end">@(c.Type == ChargeType.Utility ? $"{(c.UnitRate ?? 0).Kes()} per {c.UnitOfMeasure}" : (c.DefaultAmount ?? 0).Kes())</td>
                        <td class="text-end">@(c.TaxPercent > 0 ? $"{c.TaxPercent:0.##}%" : "—")</td>
                        <td><span class="status-chip @(c.IsActive ? "status-ok" : "status-muted")">@(c.IsActive ? "Active" : "Retired")</span></td>
                        <td class="text-end">@if (canAdmin) { <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
