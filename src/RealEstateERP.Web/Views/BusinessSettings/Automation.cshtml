@model AutomationViewModel
@{
    ViewData["Title"] = "Automation";
    var f = Model.Form;
    var s = Model.Status;
}
<div class="page-head"><h1 class="page-title">Business settings</h1></div>

<div class="settings-grid">
    <partial name="_SettingsNav" />
    <div>
        @if (s.LastSummary is not null)
        {
            <div class="sub-banner sub-banner-info"><i class="bi bi-clock-history"></i><span>Last automatic run: @s.LastSummary</span></div>
        }
        <form method="post" asp-action="Automation">
            <section class="panel mb-3">
                <h2 class="panel-title mb-1">Monthly invoices</h2>
                <p class="small text-body-secondary">Creates and issues every active lease's invoice for the month, exactly like Invoices &gt; Generate. Leases already invoiced are skipped.</p>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-inv" name="AutoInvoiceEnabled" value="true" checked="@f.AutoInvoiceEnabled" />
                    <input type="hidden" name="AutoInvoiceEnabled" value="false" />
                    <label class="form-check-label" for="auto-inv">Invoice automatically each month</label>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="auto-day" class="small">On day</label>
                    <input id="auto-day" name="AutoInvoiceDay" value="@f.AutoInvoiceDay" class="form-control form-control-sm" style="width: 80px" inputmode="numeric" />
                    <span class="small text-body-secondary">of the month (1-28). If the day is missed, it runs the next day.</span>
                </div>
                @if (s.LastAutoInvoiceMonth is DateOnly m) { <p class="small text-body-secondary mt-2 mb-0">Last automatic invoicing: @m.ToString("MMMM yyyy").</p> }
            </section>

            <section class="panel mb-3">
                <h2 class="panel-title mb-1">Late penalties</h2>
                <p class="small text-body-secondary">Applies the same penalties as Arrears &gt; Late penalties, once per overdue invoice. A unit's own grace period or fixed penalty always wins.</p>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-pen" name="AutoPenaltiesEnabled" value="true" checked="@f.AutoPenaltiesEnabled" />
                    <input type="hidden" name="AutoPenaltiesEnabled" value="false" />
                    <label class="form-check-label" for="auto-pen">Apply late penalties automatically every day</label>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="pen-grace">Grace days after the due date</label>
                        <input id="pen-grace" name="PenaltyGraceDays" value="@f.PenaltyGraceDays" class="form-control form-control-sm" inputmode="numeric" placeholder="System default: @s.SystemGraceDays" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="pen-pct">Penalty (% of the overdue balance)</label>
                        <input id="pen-pct" name="PenaltyPercent" value="@f.PenaltyPercent?.ToString("0.##")" class="form-control form-control-sm" inputmode="decimal" placeholder="System default: @s.SystemPenaltyPercent.ToString("0.##")%" />
                    </div>
                </div>
                <p class="form-text mb-0">Leave blank to use the system defaults. These also apply to the manual penalty preview.</p>
            </section>

            <section class="panel mb-3">
                <h2 class="panel-title mb-1">Emails to tenants</h2>
                <p class="small text-body-secondary">Sent to tenants who have an email address. Replies go to your business email.</p>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="em-inv" name="EmailInvoicesToTenants" value="true" checked="@f.EmailInvoicesToTenants" />
                    <input type="hidden" name="EmailInvoicesToTenants" value="false" />
                    <label class="form-check-label" for="em-inv">Email invoices when they're issued automatically (and penalty invoices)</label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="em-rct" name="EmailReceiptsToTenants" value="true" checked="@f.EmailReceiptsToTenants" />
                    <input type="hidden" name="EmailReceiptsToTenants" value="false" />
                    <label class="form-check-label" for="em-rct">Email a receipt whenever a payment is recorded</label>
                </div>
                <label class="form-label small mb-1" for="pay-instr">How tenants pay (printed on invoice emails)</label>
                <textarea id="pay-instr" name="PaymentInstructions" class="form-control form-control-sm" rows="3" maxlength="1000"
                          placeholder="e.g. M-PESA Paybill 123456, account: your unit number (e.g. A3). Bank: Equity Bank, account 0123456789.">@f.PaymentInstructions</textarea>
            </section>
            <section class="panel mb-3">
                <h2 class="panel-title mb-1">Advertise vacant units</h2>
                <p class="small text-body-secondary">Every day, each vacant unit with a rent and no listing is listed for rent on the public site, with the estate's description and photos (the unit's interiors first). Let units hide themselves; when they're vacant again the same listing comes back. Listings show only while your subscription is active. Leads cost credits as usual.</p>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-list" name="AutoListVacantUnits" value="true" checked="@f.AutoListVacantUnits" />
                    <input type="hidden" name="AutoListVacantUnits" value="false" />
                    <label class="form-check-label" for="auto-list">List vacant units automatically</label>
                </div>
            </section>
            <button type="submit" class="btn btn-primary">Save automation settings</button>
        </form>

        <form method="post" asp-action="RunAutomationNow" class="panel mt-3 d-flex flex-wrap align-items-center gap-2">
            <div class="me-auto">
                <div class="fw-semibold">Run now</div>
                <div class="small text-body-secondary">Does whatever is due today straight away (safe to repeat: nothing is invoiced or penalised twice). The daily job runs every hour otherwise.</div>
            </div>
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-play-circle me-1"></i>Run now</button>
        </form>
    </div>
</div>
