@{
    ViewData["Title"] = "Features";
}
<section class="page-head">
    <div class="container">
        <h1>Features</h1>
        <p class="section-intro">What ShambaNyumba does today, and what's coming next.</p>
    </div>
</section>
<section class="section pt-3">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-6"><div class="feature"><i class="bi bi-diagram-3"></i><h3>Property structure</h3><p>Model any layout: estate, block, floor, unit. Apartments, shops, offices, plots and warehouses.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-file-earmark-text"></i><h3>Lease management</h3><p>Start and end dates, rent, deposit, notice period, recurring charges, renewals and early termination.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-droplet-half"></i><h3>Utility meter billing</h3><p>Enter this month's water or electricity reading; consumption and the charge are calculated for you.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-receipt-cutoff"></i><h3>Invoices and receipts</h3><p>Monthly invoices for every lease, one-off invoices, and receipts for every payment, as PDFs.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-arrow-left-right"></i><h3>Payment allocation</h3><p>One payment can settle several invoices, oldest first. Overpayments carry forward automatically.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-graph-up"></i><h3>Reports</h3><p>Invoiced vs collected, arrears ageing, occupancy and revenue by property.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-briefcase"></i><h3>Agency tools</h3><p>Owners, agents, management contracts, commission and monthly owner statements. Agents see only their own contracts.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-house-check"></i><h3>Plot and house sales</h3><p>Buyers, deposits and instalment schedules, overdue instalments, and transfer steps from sale agreement to title and handover.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-calculator"></i><h3>Development costs and margins</h3><p>Purchase, development and subdivision costs, budget against actual, cost and margin per plot or unit, break-even and rental yield.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-megaphone"></i><h3>Listings and verified leads</h3><p>Advertise vacant units and plots for free on the public Properties pages. Pay credits only for enquiries confirmed by a real person.</p></div></div>
            <div class="col-md-6"><div class="feature"><i class="bi bi-chat-dots"></i><h3>SMS and email <span class="soon">Coming soon</span></h3><p>Rent reminders, receipts and renewal notices sent straight to tenants.</p></div></div>
        </div>
    </div>
</section>
