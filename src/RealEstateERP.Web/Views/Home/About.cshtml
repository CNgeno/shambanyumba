@{
    ViewData["Title"] = "About";
}
<section class="page-head">
    <div class="container prose">
        <h1>About ShambaNyumba</h1>
        <p class="lead">Built in Kenya for the way property is actually run here.</p>
        <p>
            Most landlords still reconcile M-PESA messages against a handwritten register, bill water by hand every month,
            and only find out about arrears when they become a dispute. International property software is priced in dollars
            and doesn't fit how local portfolios are owned and managed.
        </p>
        <p>
            ShambaNyumba is one system for owners, agencies and developers: properties, tenants, leases, billing,
            collections and reporting, priced in shillings and designed to work on a phone over a slow connection.
        </p>
        <a asp-action="Contact" class="btn btn-gradient mt-2">Talk to us</a>
    </div>
</section>
