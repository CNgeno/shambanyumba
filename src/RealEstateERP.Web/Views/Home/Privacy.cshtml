@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="page-head">
    <div class="container prose">
        <h1>Privacy Policy</h1>
        <p class="draft-note">Draft: this policy will be finalised, in line with the Kenya Data Protection Act 2019, before public launch.</p>
        <h2>What it will cover</h2>
        <ul>
            <li>What personal data is collected about account users and their tenants</li>
            <li>Why it's collected and the legal basis for processing it</li>
            <li>Where it's stored, who can access it, and how long it's kept</li>
            <li>How to access, correct or delete your data</li>
            <li>How to contact the data protection officer</li>
        </ul>
    </div>
</section>
