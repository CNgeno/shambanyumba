@{
    ViewData["Title"] = "Software for landlords, agencies and developers in Kenya";
    var latest = ViewData["Latest"] as IReadOnlyList<RealEstateERP.Core.Models.PublicListingCard> ?? [];
    ViewData["NavOverHero"] = true;
}
<section class="hero">
    <div class="container hero-inner">
        <p class="hero-eyebrow"><i class="bi bi-house-heart-fill"></i>For landlords, agencies and developers</p>
        <h1>Rentals and plot sales, <span class="accent">without the paperwork</span></h1>
        <p class="hero-lead">Bill tenants and match every payment. Sell plots and houses on instalments, from deposit to title. And know the margin on every project.</p>

        <form class="hero-card" method="get" action="/Identity/Account/Register" role="search" aria-label="Start a free trial">
            <label for="hero-email" class="visually-hidden">Your email address</label>
            <div class="hero-field">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <input id="hero-email" name="email" type="email" placeholder="Enter your email address" autocomplete="email" required />
            </div>
            <button type="submit" class="btn btn-accent btn-lg">Start free trial</button>
        </form>
        <p class="hero-note"><i class="bi bi-check2-circle"></i>14 days free <i class="bi bi-check2-circle"></i>No card needed <i class="bi bi-check2-circle"></i>Keep your data if you subscribe</p>
        <div class="mt-3 d-flex flex-wrap align-items-center gap-3">
        <form method="post" asp-area="" asp-controller="Demo" asp-action="Start" class="d-inline">
            <button type="submit" class="btn btn-light"><i class="bi bi-play-btn-fill me-1"></i>Try the live demo</button>
        </form>
            <a href="/tour" class="hero-tour-link"><i class="bi bi-play-circle-fill me-1"></i>See how it works in 3 minutes</a>
        </div>
    </div>
</section>

<section class="section see-it" aria-labelledby="see-it-title">
    <div class="container">
        <div class="text-center mb-4">
            <p class="hero-eyebrow justify-content-center"><i class="bi bi-play-circle-fill"></i>See it in action</p>
            <h2 id="see-it-title" class="section-title">Pick what you do, see how it works</h2>
            <p class="section-lead">A short guided tour of each journey, from setup to money in the bank.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-4"><a href="/tour#landlord" class="see-card"><i class="bi bi-house-door"></i><h3>Landlords</h3><p>Estate setup, charges and water, one-click invoices, payments, arrears, and true profit.</p><span>Take the tour <i class="bi bi-arrow-right"></i></span></a></div>
            <div class="col-md-4"><a href="/tour#developer" class="see-card"><i class="bi bi-grid-3x3-gap"></i><h3>Developers and land sellers</h3><p>Land costs, subdivision into plots, instalment sales, titles, and the margin on every plot.</p><span>Take the tour <i class="bi bi-arrow-right"></i></span></a></div>
            <div class="col-md-4"><a href="/tour#agency" class="see-card"><i class="bi bi-briefcase"></i><h3>Agencies</h3><p>Owners and contracts, collections, commission, owner statements and agent logins.</p><span>Take the tour <i class="bi bi-arrow-right"></i></span></a></div>
        </div>
        <p class="text-center mt-4 mb-0">
            <a href="/downloads/ShambaNyumba-Walkthrough.pdf" class="btn btn-outline-primary" download><i class="bi bi-file-earmark-arrow-down me-1"></i>Download the walkthrough (PDF, 5 pages)</a>
        </p>
    </div>
</section>

<section class="value-strip" aria-label="Highlights">
    <div class="container">
        <div class="value-card">
            <div class="value"><i class="bi bi-lightning-charge"></i><div><strong>Month's rent invoiced in one click</strong><span>Rent, charges and water readings together</span></div></div>
            <div class="value"><i class="bi bi-map"></i><div><strong>Plot sales on instalments</strong><span>Schedules, reminders and transfer steps to title</span></div></div>
            <div class="value"><i class="bi bi-graph-up-arrow"></i><div><strong>Margins you can trust</strong><span>Land, development and subdivision costs per plot</span></div></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="section-eyebrow">Everything in one place</p>
        <h2 class="section-title">For letting, selling and developing property</h2>
        <p class="section-intro mb-4">One record for every property, unit, tenant, buyer, invoice and payment, shared by owners, managers, agents and accountants.</p>
        <div class="row g-3">
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-buildings"></i><h3>Properties and units</h3><p>Estates, blocks, floors and units, with occupancy and vacancy at a glance.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-person-vcard"></i><h3>Tenants and leases</h3><p>Tenant records, ID documents, lease terms, deposits and renewal reminders.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-receipt"></i><h3>Monthly invoicing</h3><p>Rent, service charges and meter readings billed together, with VAT where it applies.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-cash-stack"></i><h3>Payments and receipts</h3><p>Record payments, split them across invoices and issue numbered receipts and statements.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-exclamation-diamond"></i><h3>Arrears and penalties</h3><p>See what's owed by 30, 60 and 90+ days, apply late penalties and track follow-ups.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-house-check"></i><h3>Plot and house sales</h3><p>Deposits and instalment schedules, overdue alerts, and every step from sale agreement to title transfer and handover.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-calculator"></i><h3>Development costs and margins</h3><p>Budget against actual for land, construction and subdivision, cost per plot, and break-even before you build.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-briefcase"></i><h3>Agency and owner payouts</h3><p>Management contracts, commission, and monthly statements to landlords. Agents see only their own work.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-megaphone"></i><h3>Listings and verified leads</h3><p>Advertise vacant units and plots for free. Pay only when a real person confirms their enquiry.</p></div></div>
            <div class="col-md-6 col-lg-4"><div class="feature"><i class="bi bi-people"></i><h3>Your whole team</h3><p>Invite owners, admins, staff, agents and accountants, each with the right level of access.</p></div></div>
        </div>
    </div>
</section>

<section class="section section-soft">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="section-eyebrow">Always up to date</p>
                <h2 class="section-title">Know where every shilling is</h2>
                <p class="section-intro">The moment a payment is recorded, the tenant's balance, the invoice and your arrears report all change with it. No more reconciling messages against a register.</p>
                <ol class="steps mt-4">
                    <li><strong>Add your properties</strong>Buildings, blocks and units with their rent.</li>
                    <li><strong>Add tenants and leases</strong>Link each tenant to a unit with their terms.</li>
                    <li><strong>Bill the month</strong>One click invoices every active lease.</li>
                    <li><strong>Record payments</strong>Receipts, balances and arrears update instantly.</li>
                </ol>
            </div>
            <div class="col-lg-6">
                <div class="ledger-card" aria-label="Example rent status for Block A">
                    <div class="ledger-head"><span>Block A, this month</span><span>Status</span></div>
                    <div class="ledger-row"><span class="unit">A-101</span><span class="pill pill-paid">Paid</span></div>
                    <div class="ledger-row"><span class="unit">A-102</span><span class="pill pill-part">KES 6,500 owing</span></div>
                    <div class="ledger-row"><span class="unit">A-103</span><span class="pill pill-paid">Paid</span></div>
                    <div class="ledger-row"><span class="unit">A-104</span><span class="pill pill-due">12 days overdue</span></div>
                    <div class="ledger-row"><span class="unit">A-105</span><span class="ledger-muted">Vacant since 3 Sep</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (latest.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                <div class="me-auto">
                    <p class="section-eyebrow">Looking for a home or a plot?</p>
                    <h2 class="section-title mb-0">Just listed</h2>
                </div>
                <a href="/marketplace" class="btn btn-outline-primary">Browse all properties</a>
            </div>
            <div class="listing-grid">
                @foreach (var item in latest) { <partial name="~/Views/PropertiesPublic/_ListingCard.cshtml" model="item" /> }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="cta-band">
            <div>
                <h2>Try it on your own properties or project</h2>
                <p>Set up your rentals, plots or agency during the free trial and keep everything when you subscribe.</p>
            </div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent btn-lg">Create your account</a>
        </div>
    </div>
</section>
