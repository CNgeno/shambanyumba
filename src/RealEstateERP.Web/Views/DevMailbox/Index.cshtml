@model DevMailboxViewModel
@{
    ViewData["Title"] = "Dev mailbox";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dev mailbox</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
<div class="container-fluid py-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h1 class="h5 mb-0 me-auto">Dev mailbox <span class="small text-body-secondary fw-normal">Development only: these emails were not sent</span></h1>
        <a href="" class="btn btn-sm btn-outline-secondary">Refresh</a>
        <form method="post" action="/dev/mailbox/clear" class="m-0"><button type="submit" class="btn btn-sm btn-outline-danger">Clear</button></form>
    </div>
    @if (Model.Emails.Count == 0)
    {
        <p class="text-body-secondary">No emails yet. Register, use "Forgot password", or invite a team member.</p>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-4">
                <div class="list-group">
                    @foreach (var e in Model.Emails)
                    {
                        <a href="/dev/mailbox?id=@e.Id" class="list-group-item list-group-item-action @(Model.Selected?.Id == e.Id ? "active" : "")">
                            <div class="fw-semibold small">@e.Subject</div>
                            <div class="small">@e.To, @e.SentAtUtc.ToEatDateTime()</div>
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-8">
                @if (Model.Selected is { } s)
                {
                    <div class="panel p-2">
                        <div class="small px-2 pb-2"><strong>To:</strong> @s.To &nbsp; <strong>Subject:</strong> @s.Subject</div>
                        <iframe src="/dev/mailbox/@s.Id/body" class="mail-frame" title="Email body" sandbox="allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"></iframe>
                    </div>
                }
            </div>
        </div>
    }
</div>
</body>
</html>
