@model IReadOnlyList<AgentSummary>
@{
    ViewData["Title"] = "Agents";
    var canAdmin = ViewData["CanAdmin"] is true;
}
<div class="page-head">
    <div class="me-auto">
        <h1 class="page-title">Agents</h1>
        <p class="page-sub">Your estate agents and their share of commission</p>
    </div>
    @if (canAdmin) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add agent</a> }
</div>
@if (Model.Count == 0)
{
    <section class="panel empty-state">
        <i class="bi bi-person-workspace" aria-hidden="true"></i>
        <h2 class="h5">No agents yet</h2>
        <p>Add your agents with their EARB licence numbers. Assign them to contracts to track their commission.</p>
    </section>
}
else
{
    <section class="panel p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Agent</th><th>EARB licence</th><th>Login</th><th class="text-end">Share</th><th class="text-end">Contracts</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr class="@(a.IsActive ? "" : "text-body-secondary")">
                        <td class="fw-semibold">@a.FullName<div class="small text-body-secondary fw-normal">@RealEstateERP.Core.Common.KenyanPhone.Display(a.Phone)</div></td>
                        <td>@(a.LicenseNumber ?? "—")</td>
                        <td class="small">@(a.LoginEmail ?? "No login")</td>
                        <td class="text-end">@a.CommissionSharePercent.ToString("0.##")%</td>
                        <td class="text-end">@a.ActiveContracts</td>
                        <td><span class="status-chip @(a.IsActive ? "status-ok" : "status-muted")">@(a.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            @if (canAdmin)
                            {
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    @if (a.ActiveContracts > 0)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">Move contracts</button>
                                            <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px">
                                                <form method="post" asp-action="Reassign" asp-route-id="@a.Id">
                                                    <label class="form-label small" for="to-@a.Id">Move @a.FullName's open contracts to</label>
                                                    <select id="to-@a.Id" name="toAgentId" class="form-select form-select-sm mb-2">
                                                        @foreach (var other in Model.Where(x => x.Id != a.Id && x.IsActive)) { <option value="@other.Id">@other.FullName</option> }
                                                        <option value="">No agent</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-primary w-100">Move contracts</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
<p class="small text-body-secondary mt-2"><a asp-controller="Remittances" asp-action="AgentCommissions">See agent commission by month</a></p>
