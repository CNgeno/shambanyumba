@model LeaseRenewViewModel
@{
    var c = Model.Current!;
    ViewData["Title"] = $"Renew {c.LeaseNumber}";
}
<a asp-action="Details" asp-route-id="@Model.LeaseId" class="back-link"><i class="bi bi-arrow-left"></i>@c.LeaseNumber</a>
<h1 class="page-title">Renew lease</h1>
<p class="text-body-secondary mb-4">
    @c.TenantName, @c.UnitNumber at @c.AssetName. Currently @c.MonthlyRent.Kes() a month until @(c.EndDate?.ToString("d MMM yyyy") ?? "no end date").
    Renewing creates a new lease; the current one is kept in the history.
</p>

<form method="post" asp-action="Renew" asp-route-id="@Model.LeaseId" class="form-narrow" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <section class="panel mb-4">
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-sm-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" inputmode="decimal" />
                <span asp-validation-for="MonthlyRent" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="DepositAmount" class="form-label"></label>
                <input asp-for="DepositAmount" class="form-control" inputmode="decimal" />
                <div class="form-text">Carried over from the current lease. Increase it if you're collecting a top-up.</div>
            </div>
            <div class="col-sm-6">
                <label asp-for="RentDueDay" class="form-label"></label>
                <input asp-for="RentDueDay" class="form-control" inputmode="numeric" />
            </div>
            <div class="col-sm-6">
                <label asp-for="NoticePeriodDays" class="form-label"></label>
                <input asp-for="NoticePeriodDays" class="form-control" inputmode="numeric" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>
    <button type="submit" class="btn btn-primary">Renew lease</button>
    <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
