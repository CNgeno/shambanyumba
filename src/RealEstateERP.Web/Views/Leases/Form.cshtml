@using System.Globalization
@model LeaseFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New lease" : $"Edit draft {Model.LeaseNumber}";
}
<a asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i>@(isNew ? "Leases" : Model.LeaseNumber)</a>
<h1 class="page-title mb-4">@ViewData["Title"]</h1>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" class="form-narrow" id="lease-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <section class="panel mb-3">
        <h2 class="panel-title mb-3">Who and where</h2>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="TenantId" class="form-label"></label>
                <div class="d-flex gap-2">
                    <select asp-for="TenantId" class="form-select">
                        <option value="">Select a tenant...</option>
                        @foreach (var t in Model.TenantOptions)
                        {
                            <option value="@t.Id">@t.FullName@(t.Phone is null ? "" : $" ({RealEstateERP.Core.Common.KenyanPhone.Display(t.Phone)})")</option>
                        }
                    </select>
                    @if (isNew)
                    {
                        <a asp-controller="Tenants" asp-action="Create" asp-route-unitId="@Model.UnitId" class="btn btn-outline-primary text-nowrap"><i class="bi bi-person-plus"></i> New</a>
                    }
                </div>
                <span asp-validation-for="TenantId" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <label asp-for="UnitId" class="form-label"></label>
                <select asp-for="UnitId" class="form-select" id="unit-select">
                    <option value="">Select an available unit...</option>
                    @foreach (var g in Model.UnitOptions.GroupBy(u => u.AssetName))
                    {
                        <optgroup label="@g.Key">
                            @foreach (var u in g)
                            {
                                <option value="@u.Id" data-rent="@u.MonthlyRent.ToString(CultureInfo.InvariantCulture)">@u.UnitNumber@(u.NodePath is null ? "" : $", {u.NodePath}"), @u.MonthlyRent.Kes()@(u.Status == UnitStatus.Reserved ? " (reserved)" : "")</option>
                            }
                        </optgroup>
                    }
                </select>
                <span asp-validation-for="UnitId" class="invalid-feedback d-block"></span>
                @if (Model.UnitOptions.Count == 0)
                {
                    <div class="form-text text-danger">There are no available units. Free up a unit or add one first.</div>
                }
            </div>
        </div>
    </section>

    <section class="panel mb-3">
        <h2 class="panel-title mb-3">Terms</h2>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <div class="form-text">Leave blank for a month-to-month lease.</div>
            </div>
            <div class="col-sm-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" inputmode="decimal" id="rent" />
                <span asp-validation-for="MonthlyRent" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="DepositAmount" class="form-label"></label>
                <input asp-for="DepositAmount" class="form-control" inputmode="decimal" id="deposit" />
                <div class="form-text">Usually one or two months' rent.</div>
            </div>
            <div class="col-sm-6">
                <label asp-for="RentDueDay" class="form-label"></label>
                <input asp-for="RentDueDay" class="form-control" inputmode="numeric" />
                <div class="form-text">Day of the month, 1 to 28.</div>
                <span asp-validation-for="RentDueDay" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="NoticePeriodDays" class="form-label"></label>
                <input asp-for="NoticePeriodDays" class="form-control" inputmode="numeric" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </section>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" name="submit" value="activate" class="btn btn-primary">Save and activate</button>
        <button type="submit" name="submit" value="draft" class="btn btn-outline-primary">Save as draft</button>
        <a asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
    <p class="form-text mt-2">Activating marks the unit as occupied. Use a draft while the agreement is being signed.</p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var unit = document.getElementById('unit-select'), rent = document.getElementById('rent'), deposit = document.getElementById('deposit');
            unit.addEventListener('change', function () {
                var opt = unit.selectedOptions[0];
                if (!opt || !opt.dataset.rent) return;
                // Prefill only when empty or still matching the previous unit's suggestion.
                if (!rent.value || rent.value === '0' || rent.dataset.auto === '1') { rent.value = opt.dataset.rent; rent.dataset.auto = '1'; }
                if (!deposit.value || deposit.value === '0' || deposit.dataset.auto === '1') { deposit.value = opt.dataset.rent; deposit.dataset.auto = '1'; }
            });
            [rent, deposit].forEach(function (el) { el.addEventListener('input', function () { el.dataset.auto = '0'; }); });
        })();
    </script>
}
