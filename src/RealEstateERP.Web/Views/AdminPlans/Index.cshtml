@model IReadOnlyList<SubscriptionPlan>
@{
    ViewData["Title"] = "Plans";
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <h1 class="page-title mb-0 me-auto">Plans</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New plan</a>
</div>
<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Plan</th><th>Units</th><th class="text-end">Monthly fee</th><th class="text-end">Credits</th><th>Trial</th><th>For</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><strong>@p.Name</strong> <span class="text-body-secondary small">@p.Code</span></td>
                    <td>@(p.UnitLimit?.ToString() ?? "Unlimited")</td>
                    <td class="text-end">@p.MonthlyFee.Kes()</td>
                    <td class="text-end">@p.CreditsPerMonth</td>
                    <td>@p.TrialDays days</td>
                    <td>@(p.ForBusinessType?.ToString() ?? "All")</td>
                    <td><span class="status-chip @(p.IsActive ? "status-ok" : "status-bad")">@(p.IsActive ? "Active" : "Hidden")</span></td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
