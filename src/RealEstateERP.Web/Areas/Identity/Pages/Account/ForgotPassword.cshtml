@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
<h1 class="auth-title">Forgot your password?</h1>
<p class="auth-sub">Enter your email and we'll send you a link to choose a new one.</p>
<form method="post" novalidate>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
</form>
<p class="auth-switch"><a asp-page="./Login"><i class="bi bi-arrow-left"></i> Back to sign in</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
