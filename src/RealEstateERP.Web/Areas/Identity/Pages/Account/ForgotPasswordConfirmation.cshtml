@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}
<div class="auth-icon"><i class="bi bi-envelope-paper"></i></div>
<h1 class="auth-title">Check your email</h1>
<p class="auth-sub">If an account exists for that address, we've sent a link to reset the password. It expires after a short time.</p>
<partial name="_DevMailboxHint" />
<a asp-page="./Login" class="btn btn-outline-primary w-100 mt-2">Back to sign in</a>
