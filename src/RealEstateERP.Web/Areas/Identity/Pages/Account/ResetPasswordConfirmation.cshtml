@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password changed";
}
<div class="auth-icon"><i class="bi bi-shield-check"></i></div>
<h1 class="auth-title">Password changed</h1>
<p class="auth-sub">You can now sign in with your new password.</p>
<a asp-page="./Login" class="btn btn-primary w-100">Sign in</a>
